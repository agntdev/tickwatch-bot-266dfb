[
  {
    "name": "/start requests timezone and sets defaults",
    "steps": [
      {
        "send": { "text": "/start" },
        "expect": [
          {
            "method": "sendMessage",
            "payload": { "text": "Track prices and alerts from one private watchlist.\n\nSend your timezone, such as Europe/London. Quiet hours default to 22:00–07:00." }
          }
        ]
      },
      {
        "send": { "callback": "setup:utc" },
        "expect": [
          { "method": "answerCallbackQuery" },
          { "method": "editMessageText", "payload": { "text": "Your timezone is UTC. Quiet hours are 22:00–07:00." } }
        ]
      }
    ]
  }
]
